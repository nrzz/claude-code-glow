    "scripts",
    "statusline.mjs",
    ".claude-plugin",
    "skills",
    "hud"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude-code",
    "claude",
    "theme",
    "statusline",
    "status-line",
    "terminal",
    "synthwave",
    "dracula",
    "anthropic",
    "tokens",
    "hud",
    "productivity"
  ],
  "license": "MIT",
  "repository": "github:nrzz/claude-code-glow",
  "scripts": {
    "test": "node --test test/",
    "build:themes": "node scripts/build-themes.mjs"
  },
  "author": "Naresh Prabu",
  "homepage": "https://github.com/nrzz/claude-code-glow#readme",
